# Documentation only: this application reads process environment variables.
# It does not automatically load .env files.
AGENT_BASE_URL=https://your-provider.example/v1
AGENT_MODEL=your-exact-model-id
AGENT_API_KEY=fill-in-your-local-environment-only
AGENT_AUTH=bearer
AGENT_PROTOCOL=responses
# Optional; set only if your selected model supports it.
# AGENT_REASONING_EFFORT=low
AGENT_MAX_OUTPUT_TOKENS=2400
AGENT_TIMEOUT_SECONDS=90
